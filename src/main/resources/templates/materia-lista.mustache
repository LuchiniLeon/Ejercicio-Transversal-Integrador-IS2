<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Materias</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[url('https://images.unsplash.com/photo-1477346611705-65d1883cee1e?auto=format&fit=crop&w=1920&q=80')] bg-cover bg-center bg-no-repeat flex items-center justify-center min-h-screen p-4">
    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-5xl">

        <div class="flex items-center justify-between mb-6">
            <h1 class="text-3xl font-bold text-gray-800">Materias</h1>

            <a href="/materia/alta"
               class="bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 font-semibold">
                + Nueva Materia
            </a>
        </div>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">{{successMessage}}</span>
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">{{errorMessage}}</span>
        </div>
        {{/errorMessage}}

        {{#materias}}
        <table class="w-full text-sm text-left text-gray-700 border border-gray-200 rounded-lg overflow-hidden">
            <thead class="bg-gray-100 text-gray-600 uppercase text-xs">
                <tr>
                    <th class="px-4 py-3">Código</th>
                    <th class="px-4 py-3">Nombre</th>
                    <th class="px-4 py-3">Horas Totales</th>
                    <th class="px-4 py-3">Docente</th>
                    <th class="px-4 py-3">Acciones</th>
                </tr>
            </thead>
            <tbody>
                {{#lista}}
                <tr class="border-t border-gray-200 hover:bg-gray-50">
                    <td class="px-4 py-3">{{codigo}}</td>
                    <td class="px-4 py-3">{{nombre}}</td>
                    <td class="px-4 py-3">{{horasTotales}}</td>
                    <td class="px-4 py-3">{{dniDocente}}</td>
                    <td class="px-4 py-3 flex gap-2">

                        <a href="/materia/editar/{{id}}"
                           class="bg-yellow-400 text-white py-1 px-3 rounded hover:bg-yellow-500 text-xs font-semibold">
                            Editar
                        </a>

                        <form action="/materia/eliminar/{{id}}" method="post">
                            <button type="submit"
                                    onclick="return confirm('¿Estás seguro que querés eliminar esta materia?')"
                                    class="bg-red-500 text-white py-1 px-3 rounded hover:bg-red-600 text-xs font-semibold">
                                Eliminar
                            </button>
                        </form>

                    </td>
                </tr>
                {{/lista}}
            </tbody>
        </table>
        {{/materias}}

        {{^materias.lista}}
        <p class="text-center text-gray-500 mt-8 font-semibold">
            No hay materias cargadas todavía.
        </p>
        {{/materias.lista}}

        <div class="mt-6">
            <a href="/dashboard"
               class="text-blue-600 hover:underline text-sm">
                ← Volver al dashboard
            </a>
        </div>

    </div>
</body>
</html>