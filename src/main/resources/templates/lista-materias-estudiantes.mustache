<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Materias Disponibles</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[url('https://images.unsplash.com/photo-1477346611705-65d1883cee1e?auto=format&fit=crop&w=1920&q=80')] bg-cover bg-center bg-no-repeat flex items-center justify-center min-h-screen p-4">
    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-4xl">
        <div class="flex items-center justify-between mb-6">
            <h1 class="text-3xl font-bold text-gray-800">Materias Disponibles</h1>
        </div>
        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">{{successMessage}}</span>
        </div>
        {{/successMessage}}
        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">{{errorMessage}}</span>
        </div>
        {{/errorMessage}}
        {{#hayMaterias}}
        <table class="w-full text-sm text-left text-gray-700 border border-gray-200 rounded-lg overflow-hidden">
            <thead class="bg-gray-100 text-gray-600 uppercase text-xs">
                <tr>
                    <th class="px-4 py-3">Código</th>
                    <th class="px-4 py-3">Nombre</th>
                    <th class="px-4 py-3">Horas</th>
                    <th class="px-4 py-3">Docente titular</th>
                    <th class="px-4 py-3">Estado</th>
                    <th class="px-4 py-3">Acciones</th>
                </tr>
            </thead>
            <tbody>
                {{#materias}}
                <tr class="border-t border-gray-200 hover:bg-gray-50">
                    <td class="px-4 py-3">{{codigo}}</td>
                    <td class="px-4 py-3">{{nombre}}</td>
                    <td class="px-4 py-3">{{horasTotales}}</td>
                    <td class="px-4 py-3">{{docenteTitular}}</td>
                    <td class="px-4 py-3">
                        {{#inscripto}}
                            <span class="text-green-600 font-semibold text-xs">Inscripto</span>
                        {{/inscripto}}
                        {{^inscripto}}
                            <span class="text-gray-500 font-semibold text-xs">Disponible</span>
                        {{/inscripto}}
                    </td>
                    <td class="px-4 py-3 flex gap-2">
                        {{#puedeInscribirse}}
                        <form action="/inscripcion/materia/{{id}}/inscribir" method="post">
                            <button type="submit" class="bg-blue-500 text-white py-1 px-3 rounded hover:bg-blue-600 text-xs font-semibold">
                                Inscribirse
                            </button>
                        </form>
                        {{/puedeInscribirse}}
                        {{^puedeInscribirse}}
                        <span class="text-gray-400 text-xs">Ya estás inscripto</span>
                        {{/puedeInscribirse}}
                    </td>
                </tr>
                {{/materias}}
            </tbody>
        </table>
        {{/hayMaterias}}
        {{^hayMaterias}}
        {{^errorMessage}}
        <p class="text-center text-gray-500 mt-8">No hay materias disponibles en este momento.</p>
        {{/errorMessage}}
        {{/hayMaterias}}
        <div class="mt-6">
            <a href="/dashboard" class="text-blue-600 hover:underline text-sm">← Volver al dashboard</a>
        </div>
    </div>
</body>
</html>
