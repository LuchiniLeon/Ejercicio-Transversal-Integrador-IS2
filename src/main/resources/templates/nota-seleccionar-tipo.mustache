<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Cargar Nota</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-[url('https://images.unsplash.com/photo-1477346611705-65d1883cee1e?auto=format&fit=crop&w=1920&q=80')] bg-cover bg-center bg-no-repeat flex items-center justify-center min-h-screen p-4">

<div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-md">

    <h1 class="text-3xl font-bold text-center text-gray-800 mb-6">
        Cargar Nota
    </h1>

    {{#message}}
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
        {{message}}
    </div>
    {{/message}}

    {{#errorMessage}}
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
        {{errorMessage}}
    </div>
    {{/errorMessage}}

    <p class="text-center text-gray-600 mb-6">
        Seleccioná qué tipo de nota querés cargar:
    </p>

    <div class="space-y-4">
        <a href="/nota/alta/materia"
           class="block w-full text-center bg-blue-600 text-white py-3 px-4 rounded-md hover:bg-blue-700 font-semibold">
            Nota de Materia
        </a>

        <a href="/nota/alta/taller"
           class="block w-full text-center bg-indigo-600 text-white py-3 px-4 rounded-md hover:bg-indigo-700 font-semibold">
            Nota de Taller
        </a>

        <a href="/dashboard"
           class="block w-full text-center bg-red-600 text-white py-3 px-4 rounded-md hover:bg-red-700 font-semibold">
            Volver
        </a>
    </div>

</div>

</body>
</html>