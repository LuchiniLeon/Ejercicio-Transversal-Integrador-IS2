<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Materias</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<!-- FONDO -->
<body class="relative h-screen overflow-hidden flex flex-col bg-[radial-gradient(circle_at_center,#1e293b_0%,#090d16_100%)] before:absolute before:inset-0 before:bg-[radial-gradient(rgba(255,255,255,0.1)_1px,transparent_1px)] before:[background-size:24px_24px] before:-z-10">

<!-- HEADER -->
<header class="fixed top-0 left-0 right-0 h-14 bg-slate-900 border-b border-slate-700 flex items-center px-5 gap-4 z-50 shadow-sm">
    <button id="menuBtn" class="p-2 text-3xl text-blue-500">☰</button>
    <div class="flex items-center gap-2">
        <span class="text-blue-400 font-bold text-lg tracking-tight">Pentabyte</span>
    </div>
    <div class="w-px h-5 bg-gray-200"></div>
    <span class="text-slate-300 text-base">Panel de Administrador</span>
    <div class="ml-auto">
        <a href="/profile"
           class="w-9 h-9 rounded-full bg-slate-700 flex items-center justify-center text-white hover:bg-blue-600 transition"
           title="Mi perfil">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
            </svg>
        </a>
    </div>
</header>

<!-- LAYOUT -->
<div class="flex mt-14 min-h-[calc(100vh-56px)]">

    <!-- SIDEBAR -->
    <aside id="sidePanel"
        class="bg-slate-800 border-r border-slate-700 flex flex-col py-4 shadow-sm transition-all duration-200"
        style="width:210px; min-width:210px;">

        <div class="px-5 mb-1 text-[12px] font-semibold text-gray-400 uppercase tracking-widest">General</div>
        <a href="/dashboard" class="flex items-center gap-2.5 px-4 py-2 text-slate-300 hover:bg-slate-700 hover:text-white text-base font-medium border-l-2 border-transparent transition-colors">
            Inicio
        </a>

        <div class="px-5 mt-4 mb-1 text-[12px] font-semibold text-gray-400 uppercase tracking-widest">Usuarios</div>
        <a href="/docente/alta" class="flex items-center gap-2.5 px-4 py-2 text-slate-300 hover:bg-slate-700 hover:text-white text-base font-medium border-l-2 border-transparent transition-colors">
            Nuevo Docente
        </a>
        <a href="/estudiante/alta" class="flex items-center gap-2.5 px-4 py-2 text-slate-300 hover:bg-slate-700 hover:text-white text-base font-medium border-l-2 border-transparent transition-colors">
            Nuevo Estudiante
        </a>
        <a href="/asignar/profesor" class="flex items-center gap-2.5 px-4 py-2 text-slate-300 hover:bg-slate-700 hover:text-white text-base font-medium border-l-2 border-transparent transition-colors">
            Asignar Profesor
        </a>
        <a href="/editor" class="flex items-center gap-2.5 px-4 py-2 text-slate-300 hover:bg-slate-700 hover:text-white text-base font-medium border-l-2 border-transparent transition-colors">
            Editar Usuario
        </a>

        <div class="px-5 mt-4 mb-1 text-[12px] font-semibold text-gray-400 uppercase tracking-widest">Académico</div>
        <a href="/admin/materia/lista" class="flex items-center gap-2.5 px-4 py-2 text-slate-300 hover:bg-slate-700 hover:text-white text-base font-medium border-l-2 border-transparent transition-colors">
            Materias
        </a>
        <a href="/admin/materia/alta" class="flex items-center gap-2.5 px-4 py-2 text-slate-300 hover:bg-slate-700 hover:text-white text-base font-medium border-l-2 border-transparent transition-colors">
            Nueva Materia
        </a>
        <a href="/admin/carrera/lista" class="flex items-center gap-2.5 px-4 py-2 text-slate-300 hover:bg-slate-700 hover:text-white text-base font-medium border-l-2 border-transparent transition-colors">
            Carreras
        </a>

        <a href="/admin/carrera/alta" class="flex items-center gap-2.5 px-4 py-2 text-slate-300 hover:bg-slate-700 hover:text-white text-base font-medium border-l-2 border-transparent transition-colors">
            Nueva Carrera
        </a>

        <div class="px-5 mt-4 mb-1 text-[12px] font-semibold text-gray-400 uppercase tracking-widest">Taller</div>
        <a href="/admin/taller/lista" class="flex items-center gap-2.5 px-4 py-2 text-slate-300 hover:bg-slate-700 hover:text-white text-base font-medium border-l-2 border-transparent transition-colors">
            Talleres
        </a>
        <a href="/admin/taller/alta" class="flex items-center gap-2.5 px-4 py-2 text-slate-300 hover:bg-slate-700 hover:text-white text-base font-medium border-l-2 border-transparent transition-colors">
            Nuevo Taller
        </a>

        <div class="flex-1"></div>

        <div class="border-t border-slate-700 pt-3">
            <a href="/logout" class="flex items-center gap-2.5 px-4 py-2 text-slate-300 hover:bg-slate-700 hover:text-white text-base font-medium border-l-2 border-transparent transition-colors">
                Cerrar sesión
            </a>
        </div>
    </aside>

    <!-- MAIN -->
    <main class="flex-1 flex items-center justify-center p-8">

        <div class="w-full max-w-7xl bg-slate-300 backdrop-blur-sm border border-slate-400 rounded-xl shadow-lg p-8">

            <h1 class="text-3xl font-bold text-blue-600 mb-6 text-center">Lista de Materias</h1>

            {{#successMessage}}
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4">
                <span class="block sm:inline">{{successMessage}}</span>
            </div>
            {{/successMessage}}

            <div class="overflow-hidden rounded-xl border border-slate-300 bg-white shadow-sm mb-4">
            <table class="w-full text-left">
                <thead>
                    <tr class="bg-gray-100">
                        <th class="py-2 px-4 border-b">Código</th>
                        <th class="py-2 px-4 border-b">Nombre</th>
                        <th class="py-2 px-4 border-b">Horas</th>
                        <th class="py-2 px-4 border-b">Carrera</th>
                        <th class="py-2 px-4 border-b">Docente</th>
                        <th class="py-2 px-4 border-b">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {{#materias}}
                    <tr class="hover:bg-gray-50">
                        <td class="py-2 px-4 border-b">{{codigo}}</td>
                        <td class="py-2 px-4 border-b">{{nombre}}</td>
                        <td class="py-2 px-4 border-b">{{horasTotales}}</td>
                        <td class="py-2 px-4 border-b">{{nombreCarrera}}</td>
                        <td class="py-2 px-4 border-b">{{nombreDocente}}</td>
                        <td class="py-2 px-4 border-b flex gap-2">
                            <a href="/materia/editar/{{id}}"
                            class="inline-flex items-center justify-center bg-blue-600 text-white py-1 px-3 rounded hover:bg-blue-700 text-xs font-semibold">
                                Editar
                            </a>
                            <form action="/materia/eliminar/{{id}}" method="post" class="inline">
                                <button type="submit"
                                        onclick="return confirm('¿Estás seguro que querés eliminar esta materia?')"
                                        class="inline-flex items-center justify-center bg-slate-600 text-white py-1 px-3 rounded hover:bg-slate-700 text-xs font-semibold">
                                    Eliminar
                                </button>
                            </form>
                        </td>
                    </tr>
                    {{/materias}}
                    {{^materias}}
                    <tr>
                        <td colspan="6" class="text-center text-gray-500 py-6">
                            No hay materias cargadas todavía.
                        </td>
                    </tr>
                    {{/materias}}
                </tbody>
            </table>
            </div>

            <div class="flex gap-4 pt-2">
                <a href="/dashboard"
                    class="flex-1 bg-slate-600 text-white py-2 px-4 rounded-md hover:bg-slate-700 text-center font-semibold">
                    Volver
                </a>
                <a href="/admin/materia/alta"
                       class="flex-1 bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 text-center font-semibold">
                    Nueva Materia
                </a>
            </div>
        </div>
    </main>

<script>
const sidePanel = document.getElementById('sidePanel');
const menuBtn = document.getElementById('menuBtn');

menuBtn.addEventListener('click', () => {
    if (sidePanel.style.display === 'none') {
            sidePanel.style.display = 'flex';
    } else {
            sidePanel.style.display = 'none';
    }
});
</script>
</body>
</html>
