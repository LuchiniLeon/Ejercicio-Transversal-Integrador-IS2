<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Bienvenido</title>
    <script src="https://unpkg.com/@tailwindcss/browser@4"></script>
</head>
<body class="bg-[url('https://images.unsplash.com/photo-1477346611705-65d1883cee1e?auto=format&fit=crop&w=1920&q=80')] bg-cover bg-center bg-no-repeat min-h-screen flex relative">
    
    <!-- PANEL IZQUIERDO (Estructura y variables intactas) -->
    <div class="bg-white p-8 border-r border-gray-200 shadow-2xl w-full max-w-md flex flex-col justify-between shrink-0 min-h-screen overflow-y-auto z-10">
        
        <div>
            <!-- BOTONES DE CONFIGURACIÓN, PERFIL Y CERRAR SESIÓN -->
            <div class="flex items-center justify-end gap-1 mb-6">
                <a href="/settings" class="text-gray-500 hover:text-green-600 p-2 rounded-full hover:bg-green-50 transition duration-300" title="Configuraciones">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.43l-1.003.767a1.123 1.123 0 0 0-.417 1.03c.004.074.006.148.006.222 0 .074-.002.148-.006.222a1.123 1.123 0 0 0 .417 1.03l1.003.767a1.125 1.125 0 0 1 .26 1.43l-1.296 2.247a1.125 1.125 0 0 1-1.37.49l-1.216-.456a1.125 1.125 0 0 0-1.076.124a6.57 6.57 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281a1.125 1.125 0 0 0-.646-.87a6.555 6.555 0 0 1-.22-.127a1.125 1.125 0 0 0-1.074-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.43l1.004-.767a1.122 1.122 0 0 0 .417-1.03a6.57 6.57 0 0 1-.006-.222c0-.074.002-.148.006-.222a1.122 1.122 0 0 0-.417-1.03l-1.004-.767a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.49l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128c.332-.183.582-.495.646-.869L9.593 3.94Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
                </a>
                <a href="/profile" class="text-gray-500 hover:text-blue-600 p-1.5 rounded-full hover:bg-blue-50 transition duration-300" title="Mi Perfil">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
                </a>
                <a href="/logout" class="text-gray-500 hover:text-red-600 p-2 rounded-full hover:bg-red-50 transition duration-300" title="Cerrar Sesión">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15M12 9l-3 3m0 0 3 3m-3-3h12.75" /></svg>
                </a>
            </div>

            <h1 class="text-3xl font-bold text-gray-800 text-center mb-10">Panel de Control</h1>
            
            <!-- LISTA DE ENLACES (Mantenemos tus variables aquí) -->
            <div class="border-t border-gray-100 pt-6">
                {{#esAdministrador}}
                    <div class="flex flex-col space-y-1">
                        <a href="/editor?modo=oculto" class="block py-2.5 px-4 text-sm font-medium text-gray-600 hover:bg-gray-100 hover:text-gray-900 rounded-lg transition duration-200">Editar Usuario</a>
                        <a href="/docente/alta" class="block py-2.5 px-4 text-sm font-medium text-gray-600 hover:bg-gray-100 hover:text-gray-900 rounded-lg transition duration-200">Cargar nuevo Docente</a>
                        <a href="/estudiante/alta" class="block py-2.5 px-4 text-sm font-medium text-gray-600 hover:bg-gray-100 hover:text-gray-900 rounded-lg transition duration-200">Cargar nuevo Estudiante</a>
                        <a href="/asignar/profesor" class="block py-2.5 px-4 text-sm font-medium text-gray-600 hover:bg-gray-100 hover:text-gray-900 rounded-lg transition duration-200">Asignar profesor</a>
                    </div>
                {{/esAdministrador}}
                {{#esSuperAdmin}}
                    <div class="flex flex-col space-y-1">
                        <a href="/superadmin/alta" class="block py-2.5 px-4 text-sm font-medium text-gray-600 hover:bg-gray-100 hover:text-gray-900 rounded-lg transition duration-200">Cargar nuevo Administrator</a>
                        <a href="/editor?modo=oculto" class="block py-2.5 px-4 text-sm font-medium text-gray-600 hover:bg-gray-100 hover:text-gray-900 rounded-lg transition duration-200">Editar Usuario</a>
                    </div>
                {{/esSuperAdmin}}
                {{#esDocente}}
                    <div class="flex flex-col space-y-1">
                        <a href="/taller/alta" class="block py-2.5 px-4 text-sm font-medium text-gray-600 hover:bg-gray-100 hover:text-gray-900 rounded-lg transition duration-200">Cargar nuevo taller</a>
                        <a href="/taller/lista" class="block py-2.5 px-4 text-sm font-medium text-gray-600 hover:bg-gray-100 hover:text-gray-900 rounded-lg transition duration-200">Ver mis talleres</a>
                        <a href="/nota/alta" class="block py-2.5 px-4 text-sm font-medium text-gray-600 hover:bg-gray-100 hover:text-gray-900 rounded-lg transition duration-200">Cargar Nota</a>
                    </div>
                {{/esDocente}}
                {{#esEstudiante}}
                    <div class="flex flex-col space-y-1">
                        <a href="/inscripcion/materia" class="block py-2.5 px-4 text-sm font-medium text-gray-600 hover:bg-gray-100 hover:text-gray-900 rounded-lg transition duration-200">Inscribirse Materia</a>
                        <a href="/inscripcion/carrera" class="block py-2.5 px-4 text-sm font-medium text-gray-600 hover:bg-gray-100 hover:text-gray-900 rounded-lg transition duration-200">Inscribirse Carrera</a>
                        <a href="/estado/carrera" class="block py-2.5 px-4 text-sm font-medium text-gray-600 hover:bg-gray-100 hover:text-gray-900 rounded-lg transition duration-200">Estado Carrera</a>
                        <a href="/estado/materia" class="block py-2.5 px-4 text-sm font-medium text-gray-600 hover:bg-gray-100 hover:text-gray-900 rounded-lg transition duration-200">Estado Materia</a>
                        <a href="/estado/taller" class="block py-2.5 px-4 text-sm font-medium text-gray-600 hover:bg-gray-100 hover:text-gray-900 rounded-lg transition duration-200">Estado Taller</a>
                        <a href="/planificador/tarea" class="block py-2.5 px-4 text-sm font-medium text-gray-600 hover:bg-gray-100 hover:text-gray-900 rounded-lg transition duration-200">Planificador Tarea</a>
                    </div>
                {{/esEstudiante}}
            </div>
        </div>
    </div>

    <!-- NOMBRE DE USUARIO FLOTANTE Y CENTRADO (Variables de usuario intactas) -->
    <div class="flex-1 flex items-center justify-center">
        <div class="text-center bg-white/70 backdrop-blur-sm p-10 rounded-3xl shadow-2xl max-w-lg">
            <p class="text-2xl font-medium text-gray-600">Bienvenido/a</p>
            
            {{#username}}
                <h2 class="text-7xl font-black text-gray-900 mt-2 mb-4">{{username}}</h2>
            {{/username}}

            <div class="mb-8 border-t border-gray-300 pt-4">
                {{#esSuperAdmin}}<p class="text-2xl font-bold text-gray-800">Super Administrator</p>{{/esSuperAdmin}}
                {{#esAdministrador}}<p class="text-2xl font-bold text-gray-800">Administrador</p>{{/esAdministrador}}
                {{#esDocente}}<p class="text-2xl font-bold text-gray-800">Docente</p>{{/esDocente}}
                {{#esEstudiante}}<p class="text-2xl font-bold text-gray-800">Estudiante</p>{{/esEstudiante}}
            </div>

            <div class="text-gray-800 space-y-2">
                <p class="font-bold text-lg">Próximamente más funcionalidades serán agregadas.</p>
            </div>
        </div>
    </div>
</body>
</html>