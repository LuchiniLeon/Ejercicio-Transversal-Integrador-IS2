<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Perfil</title>
    <script src="https://unpkg.com/@tailwindcss/browser@4"></script>
</head>
<body class="bg-[url('/imagenes/PuflitoMiradaTierna.jpeg')] bg-cover bg-no-repeat flex items-center justify-center min-h-screen p-4">
    
    <div class="bg-white/10 backdrop-blur-md border border-white/20 p-8 rounded-2xl shadow-2xl w-full max-w-2xl">
        
        <h1 class="text-3xl font-bold text-center text-gray-700 mb-6">Mi Perfil</h1>

        <div class="mb-6 text-center">
            <div class="inline-block bg-gray/20 text-white py-1 px-3 rounded-full text-sm font-semibold mb-2">Usuario</div>
            <h2 class="text-2xl text-gray font-bold">{{name}}</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
            <div>
                <p class="text-sm text-gray">Nombre Completo</p>
                <p class="font-medium text-gray">{{nombre}} {{apellido}}</p>
            </div>
            <div>
                <p class="text-sm text-gray">DNI</p>
                <p class="font-medium text-gray">{{dni}}</p>
            </div>
            <div>
                <p class="text-sm text-gray">Fecha de Nacimiento</p>
                <p class="font-medium text-gray">{{fecha}}</p>
            </div>
        </div>

        {{#esDocente}}
        <div class="bg-white/10 rounded-lg p-6 border border-white/20 mb-6">
            <h3 class="text-xl font-semibold text-gray mb-4 border-b border-white/20 pb-2">Información Académica</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div><p class="text-sm text-gray">Legajo</p><p class="font-medium text-white">{{legajo}}</p></div>
                <div><p class="text-sm text-gray">Cargo</p><p class="font-medium text-blue-300">{{cargoDoc}}</p></div>
            </div>
        </div>
        {{/esDocente}}

        {{#esAdministrador}}
        <div class="bg-white/10 rounded-lg p-6 border border-white/20 mb-6">
            <h3 class="text-xl font-semibold text-gray mb-4 border-b border-white/20 pb-2">Información Académica</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div><p class="text-sm text-gray">Cargo</p><p class="font-medium text-white">{{cargoAdm}}</p></div>
                <div><p class="text-sm text-gray">Sector</p><p class="font-medium text-blue-300">{{sector}}</p></div>
            </div>
        </div>
        {{/esAdministrador}}

        {{#esEstudiante}}
        <div class="bg-white/10 rounded-lg p-6 border border-white/20 mb-6">
            <h3 class="text-xl font-semibold text-gray mb-4 border-b border-white/20 pb-2">Información Académica</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div><p class="text-sm text-gray">Fecha Ingreso</p><p class="font-medium text-white">{{ingreso}}</p></div>
                <div><p class="text-sm text-gray">Estado Académico</p><p class="font-medium text-blue-300">{{estado}}</p></div>
            </div>
        </div>
        {{/esEstudiante}}

        {{^esDocente}}{{^esAdministrador}}{{^esEstudiante}}
        <div class="bg-yellow-500/20 border-l-4 border-yellow-500 p-4 mb-6 rounded">
            <p class="text-sm text-yellow-100">No se ha encontrado información académica asociada a tu cuenta.</p>
        </div>
        {{/esEstudiante}}{{/esAdministrador}}{{/esDocente}}

        <div class="flex gap-4 mt-6">
            <a href="/dashboard" class="w-1/2 bg-red-600/80 text-white py-2 px-4 rounded-md hover:bg-red-700 text-center backdrop-blur-sm transition">Volver al Panel</a>
            <a href="/editor" class="w-1/2 bg-blue-600/80 text-white py-2 px-4 rounded-md hover:bg-blue-700 text-center backdrop-blur-sm transition">Editar Datos</a>
        </div>

    </div>
</body>
</html>