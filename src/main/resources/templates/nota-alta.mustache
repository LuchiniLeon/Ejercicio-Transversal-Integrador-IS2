<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Cargar Nota</title>
    <script src="https://unpkg.com/@tailwindcss/browser@4"></script>
</head>
<body class="relative h-screen overflow-hidden flex flex-col bg-[radial-gradient(circle_at_center,#1e293b_0%,#090d16_100%)] before:absolute before:inset-0 before:bg-[radial-gradient(rgba(255,255,255,0.1)_1px,transparent_1px)] before:[background-size:24px_24px] before:-z-10">

<!-- HEADER -->
<header class="fixed top-0 left-0 right-0 h-14 bg-slate-900 border-b border-slate-700 flex items-center px-5 gap-4 z-50 shadow-sm">
    <button id="menuBtn" class="p-2 text-3xl text-blue-500">☰</button>
    <div class="flex items-center gap-2">
        <span class="text-blue-400 font-bold text-lg tracking-tight">Pentabyte</span>
    </div>
    <div class="w-px h-5 bg-gray-200"></div>
    <span class="text-slate-300 text-base">Panel de docente</span>
    <div class="ml-auto">
        <a href="/profile"
           class="w-9 h-9 rounded-full bg-slate-700 flex items-center justify-center text-white hover:bg-blue-600 transition"
           title="Mi perfil">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
            </svg>
        </a>
    </div>
</header>

<!-- LAYOUT -->
<div class="flex mt-14 h-[calc(100vh-56px)] overflow-hidden">

    <!-- SIDEBAR -->
    <aside id="sidePanel"
           class="relative bg-slate-800 border-r border-slate-700 flex flex-col py-4 shadow-sm transition-all duration-200"
           style="width:210px; min-width:210px;">

        <div class="px-5 mb-1 text-[12px] font-semibold text-gray-400 uppercase tracking-widest overflow-hidden whitespace-nowrap">General</div>
        <a href="/dashboard"
           class="flex items-center gap-2.5 px-4 py-2 text-slate-300 hover:bg-gray-50 hover:text-gray-900 text-base font-medium border-l-2 border-transparent transition-colors overflow-hidden whitespace-nowrap">
            <span class="sidebar-label">Inicio</span>
        </a>

        <div class="px-5 mt-4 mb-1 text-[12px] font-semibold text-gray-400 uppercase tracking-widest overflow-hidden whitespace-nowrap">Gestión</div>
        <a href="/taller/alta"
           class="flex items-center gap-2.5 px-4 py-2 text-slate-300 hover:bg-gray-50 hover:text-gray-900 text-base font-medium border-l-2 border-transparent transition-colors overflow-hidden whitespace-nowrap">
            <span class="sidebar-label">Cargar taller</span>
        </a>
        <a href="/nota/alta"
           class="flex items-center gap-2.5 px-4 py-2 text-blue-400 border-l-2 border-blue-500 text-base font-semibold overflow-hidden whitespace-nowrap">
            <span class="sidebar-label">Cargar notas</span>
        </a>
        <a href="/nota/lista"
           class="flex items-center gap-2.5 px-4 py-2 text-slate-300 hover:bg-gray-50 hover:text-gray-900 text-base font-medium border-l-2 border-transparent transition-colors overflow-hidden whitespace-nowrap">
            <span class="sidebar-label">Notas</span>
        </a>

        <a href="/taller/lista"
           class="flex items-center gap-2.5 px-4 py-2 text-slate-300 hover:bg-gray-50 hover:text-gray-900 text-base font-medium border-l-2 border-transparent transition-colors overflow-hidden whitespace-nowrap">
            <span class="sidebar-label">Mis talleres</span>
        </a>
        <a href="/materia/lista"
           class="flex items-center gap-2.5 px-4 py-2 text-slate-300 hover:bg-gray-50 hover:text-gray-900 text-base font-medium border-l-2 border-transparent transition-colors overflow-hidden whitespace-nowrap">
            <span class="sidebar-label">Mis materias</span>
        </a>

        <div class="flex-1"></div>

        <div class="border-t border-gray-600 pt-3">
            <a href="/logout"
               class="flex items-center gap-2.5 px-4 py-2 text-slate-300 hover:bg-gray-50 hover:text-gray-900 text-base font-medium border-l-2 border-transparent transition-colors overflow-hidden whitespace-nowrap">
                <span class="sidebar-label">Cerrar sesión</span>
            </a>
        </div>
    </aside>

    <!-- MAIN -->
    <main class="flex-1 overflow-y-auto flex items-center justify-center p-8">

        <div class="w-full max-w-xl bg-slate-300 backdrop-blur-sm border border-slate-400 rounded-xl shadow-lg p-8">

            <div class="mb-6">
                <h1 class="text-3xl font-bold text-blue-600">Cargar Nota</h1>
            </div>

            {{#message}}
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
                <span class="block sm:inline">{{message}}</span>
            </div>
            {{/message}}

            {{#errorMessage}}
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
                <span class="block sm:inline">{{errorMessage}}</span>
            </div>
            {{/errorMessage}}

            <form action="/nota/alta" method="post" class="space-y-4">

                <div>
                    <label for="dniEstudiante" class="block text-gray-700 text-sm font-medium mb-1">DNI estudiante (*):</label>
                    <input type="number" id="dniEstudiante" name="dniEstudiante" min="1000000" max="99999999" required
                           class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm bg-white">
                </div>

                <div>
                    <label for="tipoNota" class="block text-gray-700 text-sm font-medium mb-1">Tipo de nota (*):</label>
                    <select id="tipoNota" name="tipoNota" required onchange="actualizarCampos()"
                            class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm bg-white">
                        <option value="">Seleccione...</option>
                        <option value="materia">Materia</option>
                        <option value="taller">Taller</option>
                    </select>
                </div>

                <div>
                    <label for="idMateria" class="block text-gray-700 text-sm font-medium mb-1">ID materia:</label>
                    <input type="number" id="idMateria" name="idMateria" disabled
                           class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm bg-white disabled:bg-gray-100 disabled:text-gray-400 disabled:cursor-not-allowed">
                </div>

                <div>
                    <label for="idTaller" class="block text-gray-700 text-sm font-medium mb-1">ID taller:</label>
                    <input type="number" id="idTaller" name="idTaller" disabled
                           class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm bg-white disabled:bg-gray-100 disabled:text-gray-400 disabled:cursor-not-allowed">
                </div>

                <div>
                    <label for="condicion" class="block text-gray-700 text-sm font-medium mb-1">Condición (*):</label>
                    <select id="condicion" name="condicion" required
                            class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm bg-white">
                        <option value="Libre">Libre</option>
                        <option value="Regular">Regular</option>
                        <option value="Promocional">Promocional</option>
                    </select>
                </div>

                <div>
                    <label for="notaFinal" class="block text-gray-700 text-sm font-medium mb-1">Nota final (*):</label>
                    <input type="number" id="notaFinal" name="notaFinal" min="1" max="10" required
                           class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm bg-white">
                </div>

                <div>
                    <label for="fechaExamen" class="block text-gray-700 text-sm font-medium mb-1">Fecha examen (*):</label>
                    <input type="date" id="fechaExamen" name="fechaExamen" min="1900-01-01" required
                           class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm bg-white">
                </div>

                <p class="text-xs text-gray-500">(*) Campos obligatorios.</p>

                <div class="flex gap-4 pt-2">
                    <a href="/nota/lista"
                       class="w-1/2 inline-block bg-slate-600 text-white py-2 px-4 rounded-md hover:bg-slate-700 text-center font-semibold text-sm">
                        Ver notas
                    </a>
                    <button type="submit"
                            class="w-1/2 bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 font-semibold text-sm">
                        Guardar Nota
                    </button>
                </div>
            </form>

        </div>

    </main>
</div>

<script>
    const sidePanel = document.getElementById('sidePanel');
    const menuBtn = document.getElementById('menuBtn');

    menuBtn.addEventListener('click', () => {
        if (sidePanel.style.display === 'none') {
            sidePanel.style.display = 'flex';
        } else {
            sidePanel.style.display = 'none';
        }
    });

    function actualizarCampos() {
        const tipo = document.getElementById("tipoNota").value;
        const materia = document.getElementById("idMateria");
        const taller = document.getElementById("idTaller");

        materia.disabled = true;
        taller.disabled = true;
        materia.value = "";
        taller.value = "";

        if (tipo === "materia") {
            materia.disabled = false;
            materia.required = true;
            taller.required = false;
        }
        if (tipo === "taller") {
            taller.disabled = false;
            taller.required = true;
            materia.required = false;
        }
    }
</script>
</body>
</html>