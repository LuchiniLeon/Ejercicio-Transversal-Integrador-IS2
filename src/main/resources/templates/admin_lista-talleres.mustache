<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Talleres</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[url('https://images.unsplash.com/photo-1477346611705-65d1883cee1e?auto=format&fit=crop&w=1920&q=80')] bg-cover bg-center bg-no-repeat flex items-center justify-center min-h-screen p-4">
    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-4xl">
        <h1 class="text-3xl font-bold text-center text-gray-800 mb-6">Talleres</h1>
        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4">
            <span class="block sm:inline">{{successMessage}}</span>
        </div>
        {{/successMessage}}
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-gray-100">
                    <th class="py-2 px-4 border-b">Título</th>
                    <th class="py-2 px-4 border-b">Horas</th>
                    <th class="py-2 px-4 border-b">Vigente</th>
                    <th class="py-2 px-4 border-b">Docente titular</th>
                    <th class="py-2 px-4 border-b">Participantes</th>
                    <th class="py-2 px-4 border-b">Alumnos</th>
                </tr>
            </thead>
            <tbody>
                {{#talleres}}
                <tr class="hover:bg-gray-50">
                    <td class="py-2 px-4 border-b">{{titulo}}</td>
                    <td class="py-2 px-4 border-b">{{hora}}</td>
                    <td class="py-2 px-4 border-b">{{vigente}}</td>
                    <td class="py-2 px-4 border-b">{{nombreDocente}}</td>
                    <td class="py-2 px-4 border-b">{{participantes}}</td>
                    <th class="py-2 px-4 border-b">{{cantAlumnos}}</th>
                </tr>
                {{/talleres}}
            </tbody>
        </table>
        <div class="flex gap-4 mt-6">
            <a href="/admin/taller/alta"
               class="w-1/2 inline-block bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 text-center">
                Nuevo Taller
            </a>
            <a href="/dashboard"
               class="w-1/2 inline-block bg-red-600 text-white py-2 px-4 rounded-md hover:bg-red-700 text-center">
                Volver
            </a>
        </div>
    </div>
</body>
</html>