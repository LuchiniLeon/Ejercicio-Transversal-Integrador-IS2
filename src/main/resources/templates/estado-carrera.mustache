<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Estado de Carrera</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[url('https://images.unsplash.com/photo-1477346611705-65d1883cee1e?auto=format&fit=crop&w=1920&q=80')] bg-cover bg-center bg-no-repeat flex items-center justify-center min-h-screen p-4">
    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-4xl">
        <div class="flex items-center justify-between mb-6">
            <h1 class="text-3xl font-bold text-gray-800">Estado de Carrera</h1>
        </div>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4">
            <span class="block sm:inline">{{successMessage}}</span>
        </div>
        {{/successMessage}}
        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4">
            <span class="block sm:inline">{{errorMessage}}</span>
        </div>
        {{/errorMessage}}

        <table class="w-full text-sm text-left text-gray-700 border border-gray-200 rounded-lg overflow-hidden">
            <thead class="bg-gray-100 text-gray-600 uppercase text-xs">
                <tr>
                    <th class="px-4 py-3">ID</th>
                    <th class="px-4 py-3">Duración</th>
                    <th class="px-4 py-3">Modalidad</th>
                    <th class="px-4 py-3">Estado</th>
                    <th class="px-4 py-3">Fecha de ingreso</th>
                    <th class="px-4 py-3">Año de ingreso</th>
                </tr>
            </thead>
            <tbody>
                {{#carreras}}
                <tr class="border-t border-gray-200 hover:bg-gray-50">
                    <td class="px-4 py-3">{{id}}</td>
                    <td class="px-4 py-3">{{duracion}} años</td>
                    <td class="px-4 py-3">{{modalidad}}</td>
                    <td class="px-4 py-3">{{estado}}</td>
                    <td class="px-4 py-3">{{fechaIngreso}}</td>
                    <td class="px-4 py-3">{{anioIngreso}}</td>
                </tr>
                {{/carreras}}
            </tbody>
        </table>

        {{^carreras}}
        <p class="text-center text-gray-500 mt-8">No estás inscripto en ninguna carrera todavía.</p>
        {{/carreras}}

        <div class="mt-6">
            <a href="/dashboard" class="text-blue-600 hover:underline text-sm">← Volver al dashboard</a>
        </div>
    </div>
</body>
</html>
