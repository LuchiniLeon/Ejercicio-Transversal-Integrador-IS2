<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editor de Mi Perfil</title>
    <script src="https://unpkg.com/@tailwindcss/browser@4"></script>
</head>
<body class="relative h-screen overflow-hidden flex flex-col bg-[radial-gradient(circle_at_center,_#1e293b_0%,_#090d16_100%)] before:absolute before:inset-0 before:bg-[radial-gradient(rgba(255,255,255,0.1)_1px,transparent_1px)] before:[background-size:24px_24px] before:-z-10">


    <!-- HEADER -->
    <header class="fixed top-0 left-0 right-0 h-14 bg-slate-900 border-b border-slate-700 flex items-center px-5 gap-4 z-50 shadow-sm">
        <button id="menuBtn" class="p-2 text-3xl text-blue-500">☰</button>
        <div class="flex items-center gap-2">
            <span class="text-blue-400 font-bold text-lg tracking-tight">Pentabyte</span>
        </div>
        <div class="w-px h-5 bg-gray-200"></div>
        <span class="text-slate-300 text-base">Editor de Perfil</span>
    </header>

    <div class="flex mt-14 min-h-[calc(100vh-56px)]">

        <!-- SIDEBAR -->
       <aside id="sidePanel" class="relative bg-slate-800 border-r border-slate-700 flex flex-col py-4 shadow-sm" style="width:210px; min-width:210px;">
            <div class="px-5 mb-1 text-[12px] font-semibold text-gray-400 uppercase tracking-widest">General</div>
            <a href="/dashboard" class="flex items-center gap-2.5 px-4 py-1.5 text-slate-300 hover:bg-slate-700 hover:text-white text-base border-l-2 border-transparent transition-colors overflow-hidden whitespace-nowrap">
                <span class="sidebar-label">Inicio</span>
            </a>

            <a href="/profile" class="flex items-center gap-2.5 px-4 py-2 text-blue-400 border-l-2 border-blue-500 text-base font-semibold overflow-hidden whitespace-nowrap">
                <span class="sidebar-label">Mi Perfil</span>
            </a>

            <div class="px-5 mt-4 mb-1 text-[12px] font-semibold text-gray-400 uppercase tracking-widest">Gestion de Estudiante</div>

            <div class="px-5 mt-4 mb-1 text-[12px] font-semibold text-gray-400 uppercase tracking-widest">Académico</div>
            <a href="/estudiante/mis-materias" class="flex items-center gap-2.5 px-4 py-1.5 text-slate-300 hover:bg-slate-700 hover:text-white text-base border-l-2 border-transparent transition-colors overflow-hidden whitespace-nowrap">
                <span class="sidebar-label">Mis Materias</span>
            </a>
            <a href="/estado/materia" class="flex items-center gap-2.5 px-4 py-1.5 text-slate-300 hover:bg-slate-700 hover:text-white text-base border-l-2 border-transparent transition-colors overflow-hidden whitespace-nowrap">
                <span class="sidebar-label">Estado Materia</span>
            </a>
            <a href="/inscripcion/carrera" class="flex items-center gap-2.5 px-4 py-1.5 text-slate-300 hover:bg-slate-700 hover:text-white text-base border-l-2 border-transparent transition-colors overflow-hidden whitespace-nowrap">
                <span class="sidebar-label">Inscribirse Carrera</span>
            </a>
            <a href="/estado/carrera" class="flex items-center gap-2.5 px-4 py-1.5 text-slate-300 hover:bg-slate-700 hover:text-white text-base border-l-2 border-transparent transition-colors overflow-hidden whitespace-nowrap">
                <span class="sidebar-label">Estado Carrera</span>
            </a>

            <div class="px-5 mt-4 mb-1 text-[12px] font-semibold text-gray-400 uppercase tracking-widest">Talleres</div>
            <a href="/estudiante/talleres" class="flex items-center gap-2.5 px-4 py-1.5 text-slate-300 hover:bg-slate-700 hover:text-white text-base border-l-2 border-transparent transition-colors overflow-hidden whitespace-nowrap">
                <span class="sidebar-label">Inscribirse Taller</span>
            </a>
            <a href="/estudiante/mis-talleres" class="flex items-center gap-2.5 px-4 py-1.5 text-slate-300 hover:bg-slate-700 hover:text-white text-base border-l-2 border-transparent transition-colors overflow-hidden whitespace-nowrap">
                <span class="sidebar-label">Mis Talleres</span>
            </a>
            <a href="/estado/taller" class="flex items-center gap-2.5 px-4 py-1.5 text-slate-300 hover:bg-slate-700 hover:text-white text-base border-l-2 border-transparent transition-colors overflow-hidden whitespace-nowrap">
                <span class="sidebar-label">Estado Taller</span>
            </a>

            
            <div class="px-5 mt-4 mb-1 text-[12px] font-semibold text-gray-400 uppercase tracking-widest">Panel</div>

            <a href="/planificador/tarea" class="flex items-center gap-2.5 px-4 py-2 text-slate-300 hover:bg-slate-700 hover:text-white text-base font-medium border-l-2 border-transparent transition-colors overflow-hidden whitespace-nowrap">
                <span class="sidebar-label">Planificador Tarea</span>
            </a>

            <div class="flex-1"></div>
            <div class="border-t border-slate-700 pt-3">
                <a href="/logout" class="flex items-center gap-2.5 px-4 py-2 text-slate-300 hover:bg-slate-700 text-base font-medium border-l-2 border-transparent transition-colors">Cerrar Sesion</a>
            </div>
        </aside>

        <!-- MAIN -->
        <main class="flex-1 flex items-start justify-center p-8">
            <div class="w-full max-w-2xl bg-slate-50 rounded-xl shadow-lg border border-slate-200 p-8">
                
                <!-- Cambiado el fondo de esta sección de slate-50 a slate-100 para mejor contraste interno -->
                <div class="mb-8 text-center bg-slate-100 p-4 rounded-lg border border-slate-200">
                    <div class="inline-block bg-blue-100 text-blue-700 py-1 px-3 rounded-full text-xs font-bold uppercase tracking-wider mb-2">Usuario</div>
                    <h2 class="text-2xl text-slate-800 font-bold">{{name}}</h2>
                </div>

                {{#modificarUsuario}}
                    <div class="mb-8 max-w-md mx-auto">
                        <form action="/editor?modo=oculto" method="GET" class="flex gap-2">
                            <!-- Cambiado bg-white a bg-slate-50 -->
                            <input type="text" name="buscarUsuario" value="{{busquedaActual}}" placeholder="Buscar usuario..." class="w-full pl-4 pr-4 py-2 border border-slate-300 rounded-lg text-sm bg-slate-50 focus:ring-2 focus:ring-blue-500 outline-none">
                            <button type="submit" class="bg-slate-800 text-white px-5 py-2 rounded-lg text-sm font-semibold hover:bg-slate-900 transition">Buscar</button>
                            {{#busquedaActual}}
                                <a href="/editor?modo=oculto" class="bg-slate-200 px-3 py-2 rounded-lg text-sm font-semibold">✕</a>
                            {{/busquedaActual}}
                        </form>
                    </div>

                    <div class="space-y-3 max-w-md mx-auto mb-6">
                        {{#listaUsuarios}}
                            <div class="bg-slate-100 p-3 rounded-lg border-l-4 border-slate-600 flex justify-between items-center">
                                <div>
                                    <p class="font-bold text-sm text-slate-800">@{{nombreUsuario}}</p>
                                    <p class="text-xs text-slate-600">{{nombre}} {{apellido}}</p>
                                </div>
                                <a href="/editor?modo=oculto&buscarUsuario={{nombreUsuario}}" class="text-xs bg-slate-800 text-white px-2 py-1 rounded hover:bg-slate-900 font-medium transition">Seleccionar</a>
                            </div>
                        {{/listaUsuarios}}
                    </div>
                {{/modificarUsuario}}

                <form action="{{#modificarUsuario}}/save-admin{{/modificarUsuario}}{{^modificarUsuario}}/save-usuario{{/modificarUsuario}}" method="POST" class="space-y-6">
                    <input type="hidden" name="buscarUsuario" value="{{name}}"> 
                    {{#modificarUsuario}}<input type="hidden" name="modificarUsuario" value="true">{{/modificarUsuario}}
                    {{#esDocente}}<input type="hidden" name="esDocente" value="true">{{/esDocente}}
                    {{#esAdministrador}}<input type="hidden" name="esAdministrador" value="true">{{/esAdministrador}}
                    {{#esEstudiante}}<input type="hidden" name="esEstudiante" value="true">{{/esEstudiante}}

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-slate-700 text-sm font-medium mb-1">Nombre</label>
                            <!-- Cambiado bg-white a bg-slate-50 -->
                            <input type="text" name="nombre" value="{{nombre}}" required class="w-full px-3 py-2 border border-slate-300 rounded-md bg-slate-50 focus:ring-2 focus:ring-blue-500 outline-none">
                        </div>
                        <div>
                            <label class="block text-slate-700 text-sm font-medium mb-1">Apellido</label>
                            <input type="text" name="apellido" value="{{apellido}}" required class="w-full px-3 py-2 border border-slate-300 rounded-md bg-slate-50 focus:ring-2 focus:ring-blue-500 outline-none">
                        </div>
                    </div>

                    <div>
                        <label class="block text-slate-700 text-sm font-medium mb-1">Fecha de Nacimiento</label>
                        <input type="text" name="fecha" value="{{fecha}}" required class="w-full px-3 py-2 border border-slate-300 rounded-md bg-slate-50 focus:ring-2 focus:ring-blue-500 outline-none">
                    </div>

                    {{#modificarUsuario}}
                        <div class="bg-slate-100 p-4 rounded-lg">
                            <label class="block text-slate-700 text-sm font-medium mb-1">DNI (Inmutable)</label>
                            <input type="text" value="{{dni}}" readonly class="w-full px-3 py-2 border border-slate-300 rounded-md bg-slate-200 text-slate-500 cursor-not-allowed">
                        </div>
                        {{#esDocente}}<div class="grid grid-cols-2 gap-4"><input type="text" name="legajo" value="{{legajo}}" class="border border-slate-300 p-2 rounded bg-slate-50"><input type="text" name="cargoDoc" value="{{cargoDoc}}" class="border border-slate-300 p-2 rounded bg-slate-50"></div>{{/esDocente}}
                    {{/modificarUsuario}}

                    <div class="flex gap-4 pt-4 border-t border-slate-200"> 
                        {{^modificarUsuario}}
                            <a href="/mensaje-advertencia" class="flex-1 bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 text-center text-sm font-medium transition-colors">Pedir Cambios</a>
                        {{/modificarUsuario}} 
                        
                        <button type="submit" class="flex-1 bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 text-center text-sm font-medium transition-colors">Guardar Cambios</button>

                        <a href="/dashboard" class="flex-1 bg-slate-600 text-white py-2 px-4 rounded-md hover:bg-slate-700 text-center text-sm font-medium transition-colors">Cancelar</a>
                    </div>
                </form> 
            </div>
        </main>
    </div>

    <script>
    const sidePanel = document.getElementById('sidePanel');
    const menuBtn = document.getElementById('menuBtn');
    menuBtn.addEventListener('click', () => {
        sidePanel.style.display = (sidePanel.style.display === 'none') ? 'flex' : 'none';
    });
    </script>
</body>
</html>