<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Cargar Nota de Materia</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[url('https://images.unsplash.com/photo-1477346611705-65d1883cee1e?auto=format&fit=crop&w=1920&q=80')] bg-cover bg-center bg-no-repeat flex items-center justify-center min-h-screen p-4">
    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-md">
        <h1 class="text-3xl font-bold text-center text-gray-800 mb-6">Cargar Nota de Materia</h1>

        {{#message}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">{{message}}</span>
        </div>
        {{/message}}
        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">{{errorMessage}}</span>
        </div>
        {{/errorMessage}}

        <form action="/nota/alta/materia" method="post" class="space-y-4">
            <div>
                <label for="dniEstudiante" class="block text-gray-700 text-sm font-medium mb-1">DNI estudiante (*):</label>
                <input type="number" id="dniEstudiante" name="dniEstudiante" min="1000000" max="99999999" required
                       placeholder="Ej. 12345678"
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
                <label for="idMateria" class="block text-gray-700 text-sm font-medium mb-1">Materia (*):</label>
                <select id="idMateria" name="idMateria" required
                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="" disabled selected>Seleccioná una materia</option>
                    {{#materias}}
                    <option value="{{id}}">{{nombre}} — Código {{codigo}}</option>
                    {{/materias}}
                </select>
            </div>
            <div>
                <label for="condicion" class="block text-gray-700 text-sm font-medium mb-1">Condición (*):</label>
                <select id="condicion" name="condicion" required
                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="Libre">Libre</option>
                    <option value="Regular">Regular</option>
                    <option value="Promocional">Promocional</option>
                </select>
            </div>
            <div>
                <label for="notaFinal" class="block text-gray-700 text-sm font-medium mb-1">Nota final (*):</label>
                <input type="number" id="notaFinal" name="notaFinal" min="1" max="10" required
                       placeholder="Ej. 8"
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
                <label for="fechaExamen" class="block text-gray-700 text-sm font-medium mb-1">Fecha examen (*):</label>
                <input type="date" id="fechaExamen" name="fechaExamen" min="1900-01-01" required
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <p class="text-xs text-gray-500">(*) Campos obligatorios.</p>

            <div class="flex gap-4 mt-6">
                <a href="/nota/alta"
                   class="w-1/2 inline-block bg-red-600 text-white py-2 px-4 rounded-md hover:bg-red-700 text-center">
                    Volver
                </a>
                <button type="submit"
                        class="w-1/2 bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700">
                    Guardar
                </button>
            </div>
        </form>
    </div>
</body>
</html>