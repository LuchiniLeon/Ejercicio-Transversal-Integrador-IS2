<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Opciones de Asignación</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[url('https://images.unsplash.com/photo-1477346611705-65d1883cee1e?auto=format&fit=crop&w=1920&q=80')] bg-cover bg-center bg-no-repeat flex items-center justify-center min-h-screen p-4">
    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-md">
        <h1 class="text-3xl font-bold text-center text-gray-800 mb-6">Asignar Profesor</h1>
        <p class="text-center text-gray-600 mb-6">Seleccione el tipo de asignación que desea realizar:</p>

        <div class="space-y-4">
            <a href="/admin/materia/asignar" 
               class="w-full block text-center bg-blue-600 text-white py-3 px-4 rounded-md hover:bg-blue-700 transition duration-300 font-semibold shadow-sm">
                Asignar a Materia
            </a>

            <a href="/admin/taller/asignar" 
               class="w-full block text-center bg-indigo-600 text-white py-3 px-4 rounded-md hover:bg-indigo-700 transition duration-300 font-semibold shadow-sm">
                Asignar a Taller
            </a>
        </div>

        <div class="text-center mt-6">
            <a href="/dashboard" class="text-blue-600 hover:underline text-sm">Volver al Dashboard</a>
        </div>
    </div>
</body>
</html>