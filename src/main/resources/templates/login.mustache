<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Iniciar Sesión</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<!-- FONDO -->
<body class="relative h-screen overflow-hidden flex flex-col bg-[radial-gradient(circle_at_center,#1e293b_0%,#090d16_100%)] before:absolute before:inset-0 before:bg-[radial-gradient(rgba(255,255,255,0.1)_1px,transparent_1px)] before:[background-size:24px_24px] before:-z-10">

    <!-- HEADER MINIMALISTA -->
    <header class="fixed top-0 left-0 right-0 h-14 bg-slate-900 border-b border-slate-700 flex items-center px-5 gap-4 z-50 shadow-sm">
        <div class="flex items-center gap-2">
            <span class="text-blue-400 font-bold text-lg tracking-tight">Pentabyte</span>
        </div>
        <div class="w-px h-5 bg-gray-200"></div>
        <span class="text-slate-300 text-base">Inicio de sesión</span>
    </header>

    <!-- LAYOUT SIN SIDEBAR -->
    <div class="flex mt-14 h-[calc(100vh-56px)] overflow-hidden">
        
        <!-- MAIN -->
        <main class="flex-1 overflow-y-auto flex items-center justify-center p-8">
    
            <div class="w-full max-w-md bg-slate-300 backdrop-blur-sm border border-slate-400 rounded-xl shadow-lg p-8">
    
                <div class="mb-6">
                    <h1 class="text-3xl font-bold text-center text-blue-600">Iniciar Sesión</h1>
                </div>
    
                {{#successMessage}}
                <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
                    <span class="block sm:inline">{{successMessage}}</span>
                </div>
                {{/successMessage}}
    
                {{#errorMessage}}
                <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
                    <span class="block sm:inline">{{errorMessage}}</span>
                </div>
                {{/errorMessage}}
    
                <form action="/login" method="post" class="space-y-4">
                    <div>
                        <label for="username" class="block text-gray-700 text-sm font-medium mb-1">Nombre de Usuario:</label>
                        <input type="text" id="username" name="username" required
                               class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm bg-white">
                    </div>
                    <div>
                        <label for="password" class="block text-gray-700 text-sm font-medium mb-1">Contraseña:</label>
                        <input type="password" id="password" name="password" required
                               class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm bg-white">
                    </div>
                    
                    <div class="pt-2">
                        <button type="submit"
                                class="w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 font-semibold text-sm transition-colors shadow-sm">
                            Iniciar Sesión
                        </button>
                    </div>

                    <div class="text-center mt-5 space-y-3">
                        <p class="text-gray-700 text-sm font-medium">¿No tenés una cuenta? 
                            <a href="/user/new" class="text-blue-600 hover:underline">Regístrate acá</a>
                        </p>
                        <p class="text-gray-700 text-sm font-medium">¿Olvidaste tu contraseña? 
                            <a href="/forgot-password" class="text-blue-600 hover:underline">Recuperar contraseña</a>
                        </p>
                    </div>
                </form>
            </div>
    
        </main>
    </div>
</body>
</html>