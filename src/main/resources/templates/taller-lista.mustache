<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Talleres</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<!-- FONDO -->
<body class="relative h-screen overflow-hidden flex flex-col bg-[radial-gradient(circle_at_center,#1e293b_0%,#090d16_100%)] before:absolute before:inset-0 before:bg-[radial-gradient(rgba(255,255,255,0.1)_1px,transparent_1px)] before:[background-size:24px_24px] before:-z-10">

<!-- HEADER -->
<header class="fixed top-0 left-0 right-0 h-14 bg-slate-900 border-b border-slate-700 flex items-center px-5 gap-4 z-50 shadow-sm">
    <button id="menuBtn"
        class="p-2 text-3xl text-blue-500">
        ☰
    </button>
    <div class="flex items-center gap-2">
        <span class="text-blue-400 font-bold text-lg tracking-tight">
            Pentabyte
        </span>
    </div>
    <div class="w-px h-5 bg-gray-200"></div>
        <span class="text-slate-300 text-base">
            Panel de docencia
        </span>
<div class="ml-auto">
    <a href="/profile"
       class="w-9 h-9 rounded-full bg-slate-700 flex items-center justify-center text-white hover:bg-blue-600 transition"
       title="Mi perfil">

        <svg xmlns="http://www.w3.org/2000/svg"
             fill="none"
             viewBox="0 0 24 24"
             stroke-width="1.5"
             stroke="currentColor"
             class="w-5 h-5">
            <path stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
        </svg>

    </a>
</div>
</header>

<!-- LAYOUT -->
<div class="flex mt-14 min-h-[calc(100vh-56px)]">

    <!-- SIDEBAR -->
    <aside id="sidePanel"
    class="relative bg-slate-800 border-r border-slate-700 flex flex-col py-4 shadow-sm transition-all duration-200"
    style="width:210px; min-width:210px;">

        <div id="label-general" class="px-5 mb-1 text-[12px] font-semibold text-gray-400 uppercase tracking-widest overflow-hidden whitespace-nowrap">General</div>
            <a href="/dashboard" class="flex items-center gap-2.5 px-4 py-2 text-slate-300 hover:bg-gray-50 hover:text-gray-900 text-base font-medium border-l-2 border-transparent transition-colors overflow-hidden whitespace-nowrap">
                <span class="sidebar-label">Inicio</span>
            </a>

        <div id="label-gestion" class="px-5 mt-4 mb-1 text-[12px] font-semibold text-gray-400 uppercase tracking-widest overflow-hidden whitespace-nowrap">Gestión</div>
            <a href="/taller/alta" class="flex items-center gap-2.5 px-4 py-2 text-blue-600 border-l-2 border-blue-600 text-base font-semibold overflow-hidden whitespace-nowrap">
                <span class="sidebar-label">Cargar talleres</span>
            </a>
            <a href="" class="flex items-center gap-2.5 px-4 py-2 text-slate-300 hover:bg-gray-50 hover:text-gray-900 text-base font-medium border-l-2 border-transparent transition-colors overflow-hidden whitespace-nowrap">
                <span class="sidebar-label">Cargar notas</span>
            </a>
            <a href="/taller/lista" class="flex items-center gap-2.5 px-4 py-2 text-slate-300 hover:bg-gray-50 hover:text-gray-900 text-base font-medium border-l-2 border-transparent transition-colors overflow-hidden whitespace-nowrap">
                <span class="sidebar-label">Mis talleres</span>
            </a>
            <a href="/materia/lista"
                class="flex items-center gap-2.5 px-4 py-2 text-slate-300 hover:bg-gray-50 hover:text-gray-900 text-base font-medium border-l-2 border-transparent transition-colors overflow-hidden whitespace-nowrap">
                <span class="sidebar-label">Mis materias</span>
            </a>

        <div class="flex-1"></div>

        <div class="border-t border-gray-200 pt-3">
            <a href="/logout" class="flex items-center gap-2.5 px-4 py-2 text-slate-300 hover:bg-gray-50 hover:text-gray-900 text-base font-medium border-l-2 border-transparent transition-colors overflow-hidden whitespace-nowrap">
                <span class="sidebar-label">Cerrar sesión</span>
            </a>
        </div>
    </aside>

    <!-- MAIN -->
    <main class="flex-1 flex items-start justify-center p-8">
       <div class="w-full max-w-4xl bg-slate-300 backdrop-blur-sm border border-slate-400 rounded-xl shadow-lg p-8">

            <div class="flex items-center justify-between mb-6">
                <h1 class="text-3xl font-bold text-blue-600">Mis Talleres</h1>
                <a href="/taller/alta"
                   class="bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 font-semibold">
                    + Nuevo Taller
                </a>
            </div>

            {{#successMessage}}
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
                <span class="block sm:inline">{{successMessage}}</span>
            </div>
            {{/successMessage}}

            {{#errorMessage}}
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
                <span class="block sm:inline">{{errorMessage}}</span>
            </div>
            {{/errorMessage}}

            {{#talleres}}
            <table class="w-full text-sm text-left text-gray-700 bg-white border border-slate-300 rounded-lg overflow-hidden">

                <thead class="bg-white text-slate-800 uppercase text-xs border-b border-slate-300">
                    <tr>
                        <th class="px-4 py-3">Título</th>
                        <th class="px-4 py-3">Horas</th>
                        <th class="px-4 py-3">Vigente</th>
                        <th class="px-4 py-3">Participantes</th>
                        <th class="px-4 py-3">Alumnos</th>
                        <th class="px-4 py-3">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                {{#lista}}
                <tr class="border-t border-slate-300 bg-white">
                    <td class="px-4 py-3">{{titulo}}</td>
                    <td class="px-4 py-3">{{horas}}</td>
                    <td class="px-4 py-3">{{vigente}}</td>
                    <td class="px-4 py-3">{{participantes}}</td>
                    <td class="px-4 py-3">{{cantAlumnos}}</td>
                    <td class="px-4 py-3 flex gap-2">
                        <a href="/taller/editar/{{id}}"
                           class="bg-blue-600 text-white py-1 px-3 rounded hover:bg-blue-700 text-xs font-semibold">
                            Editar
                        </a>

                        <form action="/taller/eliminar/{{id}}" method="post">
                            <button type="submit"
                                onclick="return confirm('¿Estás seguro que querés eliminar este taller?')"
                                class="bg-slate-600 text-white py-1 px-3 rounded hover:bg-slate-700 text-xs font-semibold">
                                Eliminar
                            </button>
                        </form>
                    </td>
                </tr>
                {{/lista}}
                </tbody>
            </table>
            {{/talleres}}

            {{^talleres}}
            <p class="text-center text-gray-500 mt-8">No tenés talleres cargados todavía.</p>
            {{/talleres}}

            <div class="mt-6">
                <a href="/dashboard" class="text-blue-600 hover:underline text-sm">← Volver al dashboard</a>
            </div>

        </div>
    </main>
</div>

    <script>
    const sidePanel = document.getElementById('sidePanel');
    const menuBtn = document.getElementById('menuBtn');

    menuBtn.addEventListener('click', () => {
        if (sidePanel.style.display === 'none') {
            sidePanel.style.display = 'flex';
        } else {
            sidePanel.style.display = 'none';
        }
    });
    </script>
</body>
</html>